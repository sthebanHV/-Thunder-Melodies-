{
  "name": "wavely",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/vite.mjs",
    "build": "tsc --noEmit && node scripts/vite.mjs build",
    "preview": "node scripts/vite.mjs preview",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "api:dev": "cd server && npm run dev",
    "ytm:dev": ".venv\\Scripts\\python.exe ytm-service/app.py",
    "dev:all": "concurrently -k -n web,api,ytm \"npm:dev\" \"npm:api:dev\" \"npm:ytm:dev\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "fastify": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "playwright": "^1.63.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.1"
  }
}
